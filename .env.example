# Copy to .env (next to docker-compose.yml) and change the passwords before deploying. Never commit .env.

POSTGRES_PASSWORD=change-this-database-password

# First dashboard administrator, created on first start when none exists.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password

# true when the site is served over HTTPS (it should be in production)
COOKIE_SECURE=false
# number of reverse proxies (nginx, a load balancer) in front of the app
TRUST_PROXY=0

APP_PORT=8787
DB_PORT=5433
