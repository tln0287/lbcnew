# Copy to server/.env for local development (npm run dev). Never commit the real .env.

# PostgreSQL connection. Matches the `db` service in docker-compose.yml (port published on 5433).
DATABASE_URL=postgres://lbc:lbc-dev-password@localhost:5433/lbc

PORT=8787

# First administrator, created on start-up only when no administrator exists yet.
# Afterwards manage accounts with:  npm run admin -- add <username>
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-password

# Set to true when the site is served over HTTPS (production) so the admin cookie is Secure.
COOKIE_SECURE=false

# Set to the number of reverse proxies in front of the server (e.g. 1 behind nginx) so client IPs are right.
TRUST_PROXY=0

# Folder with the built site to serve (leave unset in development; Vite serves the site and proxies /api).
# SITE_DIR=../site/dist
