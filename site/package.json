{
  "name": "lbc-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "crawl": "python ../tools/crawl.py ../crawl-snapshot",
    "images": "python ../tools/optimize_images.py ../source-media public/img",
    "data": "python ../tools/build_data.py ../crawl-snapshot src/data ../source-media ../tools/reports/link-status.json",
    "check:links": "python ../tools/check_links.py src ../tools/reports/link-status.json",
    "test:smoke": "python ../tools/smoke_test.py http://localhost:4173 ../tools/reports/screenshots",
    "newsletters": "python ../tools/render_issues.py ../source-media .",
    "docs": "python ../tools/mirror_docs.py inventory ../crawl-snapshot . ../tools/reports/documents.json && python ../tools/mirror_docs.py download ../tools/reports/documents.json ."
  },
  "dependencies": {
    "framer-motion": "^14.4.0",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "swiper": "^11.2.10"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.4"
  }
}
